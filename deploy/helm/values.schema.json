{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string", "default": "" },
    "fullnameOverride": { "type": "string", "default": "" },
    "commonLabels": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string", "default": "" },
        "pullPolicy": { "type": "string", "enum": ["Always", "Never", "IfNotPresent"], "default": "IfNotPresent" }
      }
    },
    "imagePullSecrets": { "type": "array", "default": [], "items": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] } },
    "config": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string", "default": "" },
            "tokenKey": { "type": "string", "default": "token" },
            "token": { "type": "string", "default": "" }
          }
        },
        "clusterUUID": { "type": "string", "default": "", "anyOf": [{ "pattern": "^0d[0-9a-f]{6}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, { "maxLength": 0 }] },
        "templateUUID": { "type": "string", "default": "01000000-0000-4000-8000-000160150100", "pattern": "^01[0-9a-f]{6}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "nodeclaimTTL": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "ttl": { "type": "string", "default": "50m" }
          }
        },
        "repairToleration": { "type": "string", "default": "30m" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "extraEnv": { "type": "array", "default": [], "items": { "type": "object" } },
    "podLabels": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } },
    "securityContext": { "type": "object", "default": {} },
    "podSecurityContext": { "type": "object", "default": {} },
    "priorityClassName": { "type": "string", "default": "system-cluster-critical" },
    "nodeSelector": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "default": [], "items": { "type": "object" } },
    "affinity": { "type": "object", "default": {} },
    "topologySpreadConstraints": { "type": "array", "default": [], "items": { "type": "object" } },
    "terminationGracePeriodSeconds": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }], "default": 30 },
    "revisionHistoryLimit": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }], "default": null },
    "livenessProbe": { "type": "object", "default": {} },
    "readinessProbe": { "type": "object", "default": {} },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "maxUnavailable": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^\\d+%$" }], "default": null },
        "minAvailable": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^\\d+%$" }], "default": null }
      }
    },
    "extraObjects": { "type": "array", "default": [], "items": { "type": "object" } }
  }
}
